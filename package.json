{
  "name": "merge-it-hot",
  "version": "1.0.0",
  "description": "An application for reflecting GitHub Pull Requests events to the Slack channels for PR author and all of participants.",
  "main": "src/web-app/webApp.ts",
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src/web-app/webApp.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint ./src --fix",
    "format": "prettier ./src --write",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:update-snapshots": "jest --updateSnapshot",
    "migration:generate": "ts-node ./node_modules/typeorm/cli.js migration:generate -d src/adapters/organization-settings-provider/OrgSettingsDB.ts",
    "migration:run": "ts-node ./node_modules/typeorm/cli.js migration:run -d src/adapters/organization-settings-provider/OrgSettingsDB.ts",
    "migration:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert -d src/adapters/organization-settings-provider/OrgSettingsDB.ts",
    "docker:init": "docker compose -p merge-it-hot -f assets/third-parties-compose.yml up -d",
    "docker:destroy": "docker compose -p merge-it-hot -f assets/third-parties-compose.yml down -v",
    "docker:start": "docker compose -p merge-it-hot -f assets/third-parties-compose.yml -f assets/merge-it-hot-compose.yml up --build"
  },
  "keywords": [
    "github",
    "slack",
    "review",
    "pull request",
    "devex",
    "developer experience",
    "developer productivity"
  ],
  "author": "Fedor Shchudlo",
  "license": "Apache 2.0",
  "dependencies": {
    "@slack/bolt": "^4.1.1",
    "axios": "^1.7.8",
    "cache-manager": "^6.2.0",
    "dotenv": "^16.4.6",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "keyv": "^5.2.1",
    "pg": "8.13.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "0.2.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm": "0.3.20",
    "typeorm-naming-strategies": "4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0"
  }
}
