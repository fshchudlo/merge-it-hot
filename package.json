{
  "name": "merge-it-hot",
  "version": "1.0.0",
  "description": "An application for reflecting GitHub Pull Requests events to the Slack channels for PR author and all of participants.",
  "main": "src/app.ts",
  "scripts": {
    "start": "ts-node src/app.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint ./src --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "format": "prettier ./src --write",
    "test:update-snapshots": "jest --updateSnapshot"
  },
  "keywords": [
    "github",
    "slack",
    "review",
    "pull request",
    "devex",
    "developer experience",
    "developer productivity"
  ],
  "author": "Fedor Shchudlo",
  "license": "Apache 2.0",
  "dependencies": {
    "@slack/bolt": "^4.1.1",
    "axios": "^1.7.8",
    "cache-manager": "^6.2.0",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "keyv": "^5.2.1",
    "prom-client": "^15.1.3",
    "ts-node": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  }
}
