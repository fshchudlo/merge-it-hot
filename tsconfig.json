{
  "compilerOptions": {
    "target": "es2022",
    "module": "Node16",
    "paths": {
      "@slack-building-blocks": [
        "./src/@slack-building-blocks"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": false,
    "moduleResolution": "node16",
    "rootDir": ".",
    "outDir": "./dist",
    "types": [
      "node",
      "jest"
    ],
    "typeRoots": [
      "./types",
      "./node_modules/@types",
      "./src/web-app/pr-notification-handlers/event-contracts"
    ]
  },
  "include": [
    "./**/*.ts",
    "./**/*.d.ts"
  ],
  "exclude": [
    "./node_modules"
  ]
}
