{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "baseUrl": "./",
    "paths": {
      "@slack-building-blocks": [
        "./src/@slack-building-blocks"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": false,
    "moduleResolution": "node",
    "outDir": "./dist",
    "typeRoots": [
      "./types",
      "./node_modules/@types",
      "./src/web-app/pr-notification-handlers/event-contracts"
    ]
  },
  "include": [
    "./**/*.ts"
  ],
  "exclude": [
    "./node_modules"
  ]
}
